# Server
PROJECT_NAME=Id Validator Service
API_V1_STR=/api/v1

# ML Configuration
# Threshold for document classification confidence (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.98

# File Upload Limits
# Maximum file size in bytes (default: 10MB = 10485760)
MAX_FILE_SIZE=10485760

# OCR Processing
# Padding added to cropped regions for OCR fallback (improves edge detection)
OCR_PADDING_HEIGHT=1
OCR_PADDING_WIDTH=20